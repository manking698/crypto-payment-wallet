PORT=3000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vault_db?retryWrites=true&w=majority
SIGNER_ADDRESS=0x1111111111111111111111111111111111111111
PRIVATE_KEY=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
FACTORY_ADDRESS=0x2222222222222222222222222222222222222222
USER_VAULT_BYTECODE=0x<user_vault_creation_bytecode>
EARN_CONTRACT_ADDRESS=0x3333333333333333333333333333333333333333
CARD_PAYMENT_SETTLEMENT_ADDRESS=0x4444444444444444444444444444444444444444
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=12h
JWT_ISSUER=vault-api
JWT_AUDIENCE=vault-wallet-app
CARD_GLOBAL_MONTHLY_LIMIT_USD=1000000
AUTH_USER_LIMIT_MAX=120
AUTH_USER_LIMIT_WINDOW_MS=60000
LOGIN_FAIL_SHORT_LOCK_THRESHOLD=5
LOGIN_FAIL_LONG_LOCK_THRESHOLD=20
LOGIN_FAIL_SHORT_LOCK_MS=600000
LOGIN_FAIL_LONG_LOCK_MS=86400000
LOGIN_FAIL_RESET_WINDOW_MS=3600000
